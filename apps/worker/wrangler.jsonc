{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compass-juyo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "juyo.razvanfrandes.com", "custom_domain": true }],
  "observability": { "enabled": true },

  // Postgres (the compass-datagen database) through Hyperdrive.
  // Locally: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env (read-only role compass_ro).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "0d5570d3cead4ad69805cd67233d92b3" }],

  // Claude through AI Gateway "compass" (BYOK alias "compass"); Workers AI for embeddings later.
  "ai": { "binding": "AI" },

  // Kassandra: one Durable Object per conversation, running pi-durable through PiHarness.
  "durable_objects": { "bindings": [{ "name": "KASSANDRA", "class_name": "Kassandra" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kassandra"] }],

  // Public MCP: 60 requests per minute per client. Kassandra questions: 6 per minute per client.
  "ratelimits": [
    { "name": "MCP_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ASK_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 6, "period": 60 } }
  ]
}

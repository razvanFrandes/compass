{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compass-juyo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "juyo.razvanfrandes.com", "custom_domain": true }],
  "observability": { "enabled": true },

  // The Angular app (apps/web, built by `pnpm build:web` at the repo root), served from the same origin as the API.
  // Unknown paths get index.html, so deep links like /boards/portfolio open the app. /api/* and /mcp always run the
  // Worker first: an unknown API path stays a JSON 404 and is never answered with the app's HTML.
  // Response headers (CSP and the others) come from apps/web/public/_headers.
  "assets": {
    "directory": "../web/dist/spartan-demo/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },

  // Postgres (the compass-datagen database) through Hyperdrive.
  // Locally: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env (read-only role compass_ro).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "0d5570d3cead4ad69805cd67233d92b3" }],

  // Claude through AI Gateway "compass" (BYOK alias "compass"); Workers AI bge-m3 embeds find_reviews questions.
  "ai": { "binding": "AI" },

  // Kassandra: one Durable Object per conversation, running pi-durable through PiHarness.
  // Briefs: the morning brief, one object for the group.
  // Budget: the public demo's daily budget (questions, workflow runs, decisions, brief refreshes), one object.
  // WorkflowBuilder: one object per workflow draft, the agent that builds it with the person.
  // Boards: the saved boards (Canvas) of the group, one object; seeds the sample boards on first use.
  "durable_objects": {
    "bindings": [
      { "name": "KASSANDRA", "class_name": "Kassandra" },
      { "name": "BRIEFS", "class_name": "Briefs" },
      { "name": "WORKFLOWS", "class_name": "WorkflowAgents" },
      { "name": "BUDGET", "class_name": "Budget" },
      { "name": "WORKFLOW_BUILDER", "class_name": "WorkflowBuilder" },
      { "name": "BOARDS", "class_name": "Boards" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Kassandra"] },
    { "tag": "v2", "new_sqlite_classes": ["Briefs"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkflowAgents"] },
    { "tag": "v4", "new_sqlite_classes": ["Budget"] },
    { "tag": "v5", "new_sqlite_classes": ["WorkflowBuilder"] },
    { "tag": "v6", "new_sqlite_classes": ["Boards"] }
  ],

  // Daily limits for every visitor together, per UTC day (docs/security.md). A missing key keeps its default.
  // Optional secret ADMIN_KEY (wrangler secret put ADMIN_KEY): the x-compass-admin-key header then skips these limits.
  // Secret SONIOX_API_KEY: the Soniox project key behind POST /api/voice/token (temporary keys for voice input).
  // APP_URL: the app's public origin, for the Explore link in workflow emails (APP_URL + /ask?q=).
  "vars": {
    "DAILY_LIMITS": { "question": 300, "workflow_run": 60, "decision": 120, "brief_refresh": 24, "embedding": 2000, "voice": 300, "board_write": 600 },
    "APP_URL": "https://juyo.razvanfrandes.com"
  },

  // Workflow emails, through Email Sending on compass.razvanfrandes.com. Any recipient, one sender.
  // Limits (infrastructure/do-email-quota.ts): 3 per hour and 6 per UTC day per recipient, 10 per hour per client, 50 per UTC day.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["alerts@compass.razvanfrandes.com"] }],

  // The morning brief is regenerated at 05:00 UTC (06:00–07:00 in Europe).
  "triggers": { "crons": ["0 5 * * *"] },

  // Public MCP: 60 requests per minute per client. Kassandra questions: 6 per minute per client.
  // Voice: 10 temporary speech-to-text keys per minute per client.
  // Board changes (create, rename, reorder, add or remove a widget): 60 per minute per client.
  // The brief's overview (GET /api/brief/overview, about fifteen read-only queries): 30 per minute per client.
  "ratelimits": [
    { "name": "MCP_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ASK_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 6, "period": 60 } },
    { "name": "VOICE_RATE_LIMIT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
    { "name": "BOARD_RATE_LIMIT", "namespace_id": "2010", "simple": { "limit": 60, "period": 60 } },
    { "name": "BRIEF_RATE_LIMIT", "namespace_id": "2011", "simple": { "limit": 30, "period": 60 } }
  ]
}
